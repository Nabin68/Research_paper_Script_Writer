# Python bytecode cache — regenerated automatically, not source
__pycache__/
*.pyc

# Local Claude Code session settings (machine-specific permission allowlist)
.claude/

# API credentials — never commit. Holds APIFY_TOKEN for creator_stats.py and
# the X_USERNAME / X_EMAIL / X_PASSWORD that ScrapeX logs in with.
.env

# ScrapeX's logged-in X session. This is a live credential — anyone holding it
# is logged into the account. Never commit it.
scrapex/cookies.json

# The Instagram scraper's logged-in session. Same rule as ScrapeX's cookies:
# this IS the login, so anyone holding it is logged into the account.
storage_state.json

# Instagram scraper's seen-posts ledger (rebuildable) and any downloaded media.
# The ledger is local state, not source — deleting it just means the next run
# re-reports posts it already showed you.
instagram_scraper/data/
downloads/

# Web console — installed deps and build output, both regenerated by npm
web/node_modules/
web/dist/

# OS cruft
Thumbs.db
.DS_Store
